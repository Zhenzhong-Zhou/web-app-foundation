{
  "name": "web-app-foundation-server",
  "version": "0.7.0",
  "description": "NestJS API for the Web Application Foundation",
  "author": "Zhenzhong Zhou",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\"",
    "build": "nest build",
    "api:spec": "nest build -p tsconfig.openapi.json && node dist-openapi/openapi/write-openapi.js",
    "api": "npm run api:spec && npm --prefix ../client run api:types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "migrate": "drizzle-kit migrate",
    "migrate:test": "MIGRATE_TARGET=test drizzle-kit migrate",
    "migrate:e2e": "MIGRATE_TARGET=e2e drizzle-kit migrate",
    "migrate:new": "node scripts/check-snapshots.js && drizzle-kit generate",
    "migrate:all": "npm run migrate && npm run migrate:test && npm run migrate:e2e",
    "db:studio": "drizzle-kit studio",
    "seed": "ts-node src/database/seed.ts",
    "seed:demo": "ts-node src/database/seed-demo.ts",
    "seed:volume": "ts-node src/database/seed-volume.ts",
    "org:invite": "ts-node src/cli/org-invite.ts",
    "backfill:pinyin": "ts-node src/database/backfill-pinyin.ts",
    "perf": "ts-node perf/run.ts",
    "perf:plans": "ts-node perf/plans.ts",
    "smoke:auth": "bash scripts/smoke-auth.sh",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest run --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --project e2e",
    "fix": "npm run format && npm run lint",
    "checks": "node scripts/check-snapshots.js && npm run i18n:check",
    "verify": "npm run format:check && npm run lint:ci && npm run typecheck && npm run checks && npm run build && npm test && npm run test:e2e",
    "pretest:e2e": "npm run migrate:test",
    "i18n:extract": "formatjs extract \"src/**/*.ts\" --ignore \"src/**/*.spec.ts\" --ignore src/i18n/translate.ts --additional-function-names t --format simple --throws --out-file src/i18n/en.json",
    "i18n:check": "node scripts/check-catalogues.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "intl-messageformat": "^12.1.3",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.7",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pinyin-pro": "^3.29.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "ua-parser-js": "^2.0.10",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.33",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "argon2@0.45.1": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "@scarf/scarf": false
  },
  "scarfSettings": {
    "enabled": false
  }
}
