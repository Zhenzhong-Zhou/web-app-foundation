# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Used to build links in verification / password-reset emails
CLIENT_URL=http://localhost:5173

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=foundation
DATABASE_URL=postgresql://app:change_me_locally@localhost:5432/foundation

# Separate database for integration tests — never point this at the dev DB,
# the test harness truncates tables between runs.
DATABASE_URL_TEST=postgresql://app:change_me_locally@localhost:5432/foundation_test

# Third database, for Playwright client e2e (see client/playwright.config.ts).
# Separate from DATABASE_URL_TEST so `npm run test:e2e` in server/ cannot
# truncate tables in the middle of a browser run.
#   docker compose exec postgres createdb -U app foundation_e2e
#   cd server && npm run migrate:e2e
DATABASE_URL_E2E=postgresql://app:password@localhost:5432/foundation_e2e

# Playwright only needs these if the ports differ from the defaults baked into
# client/playwright.config.ts.
# E2E_CLIENT_URL=http://localhost:5173
# E2E_API_URL=http://localhost:3000

# --- Sessions / auth ---
# Generate with: openssl rand -base64 32
SESSION_MAX_AGE_MS=2592000000
SESSION_IDLE_MS=604800000
VERIFICATION_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# --- Email (Mailpit in dev; no account or API key needed) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
# Its name is the sender an inbox shows; it signs each invitation (ADR-077)
# and heads the product's own emails beside the mark (ADR-082). Panivo, as on
# Render.
MAIL_FROM="Panivo <no-reply@localhost>"
# Set this and mail goes over Resend's HTTP API instead of SMTP. Required in
# production: managed hosts commonly block outbound port 587.
# RESEND_API_KEY=

# --- Calendar days (ADR-052) ---
# strict: a calendar day must arrive as YYYY-MM-DD. lenient: an instant at
# exactly UTC midnight is also read as its day, with a warning in the log —
# for a transition, or an integration that sends instants.
CALENDAR_DAY_INPUT=strict

# --- Registration (ADR-078) ---
# Who may create an organization themselves: open (the sign-up form, and
# Start an organization for an account with none) or invitation (only an
# organization invitation from `npm run org:invite`). Unset: invitation when
# NODE_ENV=production, open otherwise. Render sets it explicitly.
REGISTRATION=open
# Told by email of each organization invitation accepted. Optional: leave it
# empty to tell nobody. Locally the email lands in Mailpit.
OPERATOR_EMAIL=

# --- The product's name ---
# In the browser's tab and bookmarks. Empty means web-app-foundation; set it
# when the product, or one customer's deployment of it, has a name of its own.
VITE_APP_NAME=
# The name in one language the app speaks, for its tabs and marks (ADR-082):
# VITE_APP_NAME_ and the language's tag. Empty means VITE_APP_NAME. The home
# screen's name and a shared link's card stay VITE_APP_NAME. Render sets
# VITE_APP_NAME_ZH_HANS=品桥.
VITE_APP_NAME_ZH_HANS=
VITE_APP_NAME_FR_CA=
# Who the © line names, after the build's year: "© 2026 Zhenzhong (Bob)
# Zhou". Empty means no © line, as on a fork.
VITE_COPYRIGHT_HOLDER=
# The site's own address, such as https://web-app-foundation-client.onrender.com:
# a shared link's card needs its picture's full address. Empty means a card
# with no picture, as locally, where no chat app can reach it anyway.
VITE_SITE_URL=

# --- Security ---
# The header a proxy in front sets to the client's own address (ADR-011):
# cf-connecting-ip on Render. Empty means the connection's address. Keep it
# empty wherever nothing in front sets the header, here and in CI included:
# any caller could then send it and choose its own address.
CLIENT_IP_HEADER=
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# Files (ADR-059). local keeps them on disk under server/storage/; production
# uses s3 with the waf-files bucket on R2 and its own token.
FILE_STORAGE=local
# FILES_LOCAL_DIR=storage
# FILES_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# FILES_S3_REGION=auto
# FILES_BUCKET=waf-files
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_ORG_LIMIT_BYTES=1073741824
