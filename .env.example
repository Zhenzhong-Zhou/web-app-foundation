# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Used to build links in verification / password-reset emails
CLIENT_URL=http://localhost:5173

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=foundation
DATABASE_URL=postgresql://app:change_me_locally@localhost:5432/foundation

# Separate database for integration tests — never point this at the dev DB,
# the test harness truncates tables between runs.
DATABASE_URL_TEST=postgresql://app:change_me_locally@localhost:5432/foundation_test

# --- Sessions / auth ---
# Generate with: openssl rand -base64 32
SESSION_MAX_AGE_MS=2592000000
SESSION_IDLE_MS=604800000
VERIFICATION_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# --- Email (Mailpit in dev; no account or API key needed) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM="Foundation <no-reply@localhost>"

# --- Security ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Stricter limit for login / password-reset endpoints
RATE_LIMIT_AUTH_MAX=5
