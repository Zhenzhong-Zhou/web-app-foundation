#!/bin/sh
#
# Refuses a push that carries a commit authored or committed by a
# placeholder identity, such as "Claude (draft) <draft@example.invalid>"
# (docs/engineering.md, Working agreements, Commits). Removing those once took
# a history rewrite; this stops one before it reaches GitHub.
#
# Kept in the repository, since git never commits .git/hooks/ (ADR-082):
# once per clone, git config core.hooksPath scripts/hooks. The check
# itself is scripts/check-authors.sh, which CI also runs on a pull
# request's commits, for a clone without the hook.

# From the repository's top, not this file's folder, so a copy in
# .git/hooks/ finds it too.
check="$(git rev-parse --show-toplevel)/scripts/check-authors.sh"
zero=0000000000000000000000000000000000000000
placeholder=0
unchecked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch carries no commits.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: only the commits no remote has yet.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # Unquoted on purpose: range may be two words.
  # shellcheck disable=SC2086
  out=$("$check" $range 2>&1)
  status=$?

  case "$status" in
    0) ;;
    1)
      # The commits only: the advice comes once, after every ref.
      echo "Refused: $remote_ref has commits with a placeholder identity:" >&2
      printf '%s\n' "$out" | grep -E '^[0-9a-f]{7,}  ' >&2
      placeholder=1
      ;;
    128)
      # git could not read the range, and says why; the push goes on, as
      # it did before the check was a script.
      echo "$out" >&2
      ;;
    *)
      # The check itself did not run (missing, not executable): refused
      # rather than let a placeholder through unchecked.
      echo "$out" >&2
      echo "Refused: the author check could not run ($check, status $status)." >&2
      unchecked=1
      ;;
  esac
done

if [ "$placeholder" -eq 1 ]; then
  echo "Author them as Zhenzhong Zhou <bob0823.zhou@gmail.com>" >&2
  echo "(git commit --amend --reset-author, or a rebase), then push again." >&2
fi
[ "$placeholder" -eq 0 ] && [ "$unchecked" -eq 0 ]
