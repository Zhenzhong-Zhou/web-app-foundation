{
  "name": "web-app-foundation-client",
  "version": "0.3.0",
  "description": "React client for the Web Application Foundation",
  "author": "Zhenzhong Zhou",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run i18n:compile",
    "dev": "vite",
    "prebuild": "npm run i18n:compile",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run i18n:compile",
    "typecheck": "tsc -b",
    "lint": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "pretest": "npm run i18n:compile",
    "test": "vitest run",
    "pretest:watch": "npm run i18n:compile",
    "test:watch": "vitest",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.{ts,tsx}\" --ignore \"src/test/**\" --format simple --throws --out-file src/locales/en.json",
    "i18n:compile": "formatjs compile-folder --format simple --ast src/locales src/i18n/compiled",
    "i18n:check": "node scripts/check-catalogues.mjs",
    "pretest:e2e": "dotenv -e ../.env -- sh -c 'cd ../server && npm run migrate:e2e && DATABASE_URL=\"$DATABASE_URL_E2E\" npm run seed'",
    "test:e2e": "dotenv -e ../.env -- playwright test",
    "test:e2e:ui": "dotenv -e ../.env -- playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "fix": "npm run format && npm run lint",
    "verify": "npm run format:check && npm run lint:ci && npm run i18n:check && npm run build && npm test",
    "verify:all": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/source-sans-3": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^12.1.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.32",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^8.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.1",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.15.0": true
  }
}
