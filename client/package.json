{
  "name": "web-app-foundation-client",
  "version": "0.2.0",
  "description": "React client for the Web Application Foundation",
  "author": "Zhenzhong Zhou",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "dotenv -e ../.env -- sh -c 'cd ../server && npm run migrate:e2e && DATABASE_URL=\"$DATABASE_URL_E2E\" npm run seed'",
    "test:e2e": "dotenv -e ../.env -- playwright test",
    "test:e2e:ui": "dotenv -e ../.env -- playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "fix": "npm run format && npm run lint",
    "verify": "npm run format:check && npm run lint:ci && npm run build && npm test",
    "verify:all": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "jsdom": "30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.15.0": true
  }
}
