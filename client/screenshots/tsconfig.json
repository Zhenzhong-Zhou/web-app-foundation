{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.screenshots.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,

    // As e2e/tsconfig.json: Playwright transpiles these itself and resolves
    // extensionless imports the way a bundler does.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"]
}
