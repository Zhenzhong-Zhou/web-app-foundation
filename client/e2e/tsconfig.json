{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,

    // Playwright transpiles specs itself and resolves extensionless relative
    // imports the way a bundler does. Inheriting nodenext from tsconfig.node
    // would demand a `.js` suffix on every import of a `.ts` file — correct for
    // Node ESM, wrong for the runtime these files actually run in.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"]
}
